# RabbitMQ (nodeId from ~/.computebay/identity.json)
RABBITMQ_URL=amqp://localhost:5672

# Optional: cap allocatable resources (default: use full system)
# CPU_LIMIT=4
# MEMORY_LIMIT_MB=8192

# Optional: heartbeat interval (ms, default: 10000)
# HEARTBEAT_INTERVAL_MS=10000

# Optional: max concurrent jobs (default: floor(allocatableCpu))
# MAX_CONCURRENCY=4

# Optional: default job timeout (ms, default: 3600000)
# JOB_TIMEOUT_MS=3600000

# MinIO / S3 for artifact download (required when jobs use inputArtifacts.objectKey)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=job-artifacts

# Optional: root dir for per-job working dirs (default: os.tmpdir()/computebay-jobs)
# JOB_WORK_DIR=/tmp/computebay-jobs
